<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <div class="profile-img-group">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
      <div class="wounded-img-picker" title="Wounded token image (swaps at low HP)">
        <img class="wounded-img {{#unless system.tokenImageWounded}}placeholder{{/unless}}"
             src="{{#if system.tokenImageWounded}}{{system.tokenImageWounded}}{{else}}icons/svg/blood.svg{{/if}}"
             data-field="system.tokenImageWounded" width="32" height="32"/>
      </div>
    </div>
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Name"/></h1>
      {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
      use both the "grid" and "grid-Ncol" class where "N" can be any number
      from 1 to 12 and will create that number of columns.  --}}
      <div class="resources grid grid-3col">

        <div class="resource flex-group-center">
          <label for="system.health.value" class="resource-label">Health</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="number" name="system.health.value" value="{{system.health.value}}" min="0"/>
            <span> / {{system.health.max}}</span>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.mana.value" class="resource-label">Mana</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="number" name="system.mana.value" value="{{system.mana.value}}" min="0"/>
            <span> / {{system.mana.max}}</span>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.stamina.value" class="resource-label">Stamina</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="number" name="system.stamina.value" value="{{system.stamina.value}}" min="0"/>
            <span> / {{system.stamina.max}}</span>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.cr" class="resource-label">CR</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="number" name="system.cr" value="{{system.cr}}" min="0"/>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label class="resource-label">XP</label>
          <div class="resource-content flexrow flex-center flex-between">
            <span>{{system.xp}}</span>
          </div>
        </div>

        <div class="resource flex-group-center" title="AI profile — this NPC acts autonomously in combat (move/attack) and auto-resolves its defense prompts">
          <label class="resource-label">AI Profile</label>
          <div class="resource-content flexrow flex-center flex-between">
            <select name="flags.aspectsofpower.aiProfile">
              <option value="">—</option>
              {{#each config.ai.profiles as |label key|}}
              <option value="{{key}}" {{#if (eq key ../actor.flags.aspectsofpower.aiProfile)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>
        </div>

        <div class="resource flex-group-center" title="AI defense — auto: dodge/eat decided by win probability, no GM dialog; manual: GM answers prompts">
          <label class="resource-label">AI Defense</label>
          <div class="resource-content flexrow flex-center flex-between">
            <select name="flags.aspectsofpower.aiDefense">
              <option value="auto" {{#if (ne actor.flags.aspectsofpower.aiDefense "manual")}}selected{{/if}}>Auto</option>
              <option value="manual" {{#if (eq actor.flags.aspectsofpower.aiDefense "manual")}}selected{{/if}}>Manual</option>
            </select>
          </div>
        </div>

        {{!-- AI TACTICS — the faculties ai.mjs actually reads. Until 2026-08-10
              these were flag-only: the engine consumed them but no sheet
              offered them, so every NPC in the world ran on defaults and the
              faculty picker existed only on the skill sheet for authoring
              summons. Bound straight to flag dot-paths (never setFlag: the
              scope is `aspects-of-power`, so setFlag on `aspectsofpower`
              throws). --}}
        <div class="resource flex-group-center" title="AI tactics — the optional smartness faculties. Without these the creature charges straight at the nearest target.">
          <label class="resource-label">AI Tactics</label>
          <div class="resource-content flexcol">
            <label class="checkbox" title="A* route around movement-blocking walls instead of charging straight into them.">
              <input type="checkbox" name="flags.aspectsofpower.aiPathfind"
                     {{checked actor.flags.aspectsofpower.aiPathfind}} /> Pathfind
            </label>
            <label class="checkbox" title="Deviate around harmful AOE zones when the direct step would cross one.">
              <input type="checkbox" name="flags.aspectsofpower.aiHazardAvoid"
                     {{checked actor.flags.aspectsofpower.aiHazardAvoid}} /> Avoid hazards
            </label>
            <label class="checkbox" title="Flee when badly hurt with a threat nearby. Sticky: holds until HP recovers well past the threshold.">
              <input type="checkbox" name="flags.aspectsofpower.aiSelfPreserve"
                     {{checked actor.flags.aspectsofpower.aiSelfPreserve}} /> Self-preserve
            </label>
            <label class="checkbox" title="Weigh targets rather than simply attacking the nearest.">
              <input type="checkbox" name="flags.aspectsofpower.aiSmartTarget"
                     {{checked actor.flags.aspectsofpower.aiSmartTarget}} /> Smart targeting
            </label>
            <label class="checkbox" title="Prefer the target with the lowest HP fraction — a finisher.">
              <input type="checkbox" name="flags.aspectsofpower.aiFocusWeakest"
                     {{checked actor.flags.aspectsofpower.aiFocusWeakest}} /> Focus weakest
            </label>
          </div>
        </div>

        <div class="resource flex-group-center" title="Danger bubble in feet — how close a threat must be for self-preservation to trigger. Blank uses the system default.">
          <label class="resource-label">Danger (ft)</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="number" name="flags.aspectsofpower.aiDangerFt"
                   value="{{actor.flags.aspectsofpower.aiDangerFt}}" min="0" step="5" placeholder="default" />
          </div>
        </div>

        <div class="resource flex-group-center" title="Force this creature to use one specific skill as its attack, instead of picking the best affordable one.">
          <label class="resource-label">Forced Skill</label>
          <div class="resource-content flexrow flex-center flex-between">
            <select name="flags.aspectsofpower.aiSkillUuid">
              <option value="">(pick best affordable)</option>
              {{#each actor.items as |i|}}
                {{#if (eq i.type "skill")}}
                <option value="{{i.uuid}}" {{#if (eq i.uuid ../actor.flags.aspectsofpower.aiSkillUuid)}}selected{{/if}}>{{i.name}}</option>
                {{/if}}
              {{/each}}
            </select>
          </div>
        </div>

        {{!-- Barrier --}}
        {{#if (gt system.barrier.max 0)}}
        <div class="resource flex-group-center resource-barrier">
          <label class="resource-label">Barrier</label>
          <div class="resource-content flexrow flex-center flex-between">
            <span class="barrier-value">{{system.barrier.value}}</span>
            <span> / {{system.barrier.max}}</span>
          </div>
          {{#if system.barrier.affinities.length}}
          <div class="barrier-affinities">
            {{#each system.barrier.affinities as |aff|}}
              <span class="affinity-chip">{{aff}}</span>
            {{/each}}
          </div>
          {{/if}}
        </div>
        {{/if}}

        {{!-- Buff capacity — shown once anything is loaded. The toggle is the
              recipient's even when the recipient is a monster: a GM buffing
              their own tank should be able to spend its HP for the overflow. --}}
        {{#if (gt system.buffs.capacity 0)}}
        <div class="resource flex-group-center resource-buffs">
          <label class="resource-label">Buffs</label>
          <div class="resource-content flexrow flex-center flex-between">
            <span>{{system.buffs.used}} / {{system.buffs.capacity}}</span>
            <label class="overcap-toggle" title="Accept overcap buffs — they apply in full and the overflow costs HP on apply.">
              <input type="checkbox" name="system.buffs.acceptOvercap" {{checked system.buffs.acceptOvercap}} />
              <i class="fas fa-heart-crack"></i>
            </label>
          </div>
        </div>
        {{/if}}

      </div>
      <div class="resources grid grid-7col">
        <div class="resource flex-group-center">
          <label class="resource-label">DR</label>
          <div class="resource-content flexrow flex-center flex-between">
            <span>{{system.defense.dr.value}}</span>
          </div>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label">Armor</label>
          <div class="resource-content flexrow flex-center flex-between">
            <span>{{system.defense.armor.value}}</span>
          </div>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label">Veil</label>
          <div class="resource-content flexrow flex-center flex-between">
            <span>{{system.defense.veil.value}}</span>
          </div>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label">Melee Def</label>
          <div class="resource-content flexrow flex-center flex-between">
            <span>{{system.defense.melee.value}}</span>
          </div>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label">Ranged Def</label>
          <div class="resource-content flexrow flex-center flex-between">
            <span>{{system.defense.ranged.value}}</span>
          </div>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label">Block</label>
          <div class="resource-content flexrow flex-center flex-between">
            <span>{{system.defense.blockDR}}</span>
          </div>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label">Mind Def</label>
          <div class="resource-content flexrow flex-center flex-between">
            <span>{{system.defense.mind.pool}}</span>
            <span class="separator">/</span>
            <span>{{system.defense.mind.poolMax}}</span>
          </div>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label">Soul Def</label>
          <div class="resource-content flexrow flex-center flex-between">
            <span>{{system.defense.soul.pool}}</span>
            <span class="separator">/</span>
            <span>{{system.defense.soul.poolMax}}</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{!-- Default tab is specified in actor-sheet.mjs --}}
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="items">Items</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body scrollable" data-scrollable>

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="primary" data-tab="description">
      <prose-mirror name="system.biography" value="{{system.biography}}" compact>
        {{{enrichedBiography}}}
      </prose-mirror>

      {{!-- Actor Tags (direct grants: senses, boons, creature traits — GM-editable) --}}
      <div class="defense-section">
        <h3>Actor Tags</h3>
        <div class="immunity-chips">
          {{#each actorTags}}
            <span class="immunity-chip" data-tag-id="{{this.id}}" style="border-color: {{this.color}}">
              {{this.label}}{{#if ../canEditActorTags}} <a class="actor-tag-remove" title="Remove"><i class="fas fa-times"></i></a>{{/if}}
            </span>
          {{else}}
            <p class="hint">No actor tags.</p>
          {{/each}}
        </div>
        {{#if canEditActorTags}}
          <div class="form-group">
            <input type="text" class="actor-tag-input" list="actor-tag-registry-{{actor.id}}" placeholder="tag id…" />
            <datalist id="actor-tag-registry-{{actor.id}}">
              {{#each actorTagOptions}}<option value="{{this}}"></option>{{/each}}
            </datalist>
            <a class="actor-tag-add" title="Add tag"><i class="fas fa-plus"></i></a>
          </div>
        {{/if}}
      </div>
    </div>

    {{!-- Owned Items Tab --}}
    <div class="tab items" data-group="primary" data-tab="items">
       {{> "systems/aspects-of-power/templates/actor/parts/actor-items.hbs"}}
    </div>

    {{!-- Active Effects Tab --}}
    <div class="tab effects flexcol" data-group="primary" data-tab="effects">
      {{> "systems/aspects-of-power/templates/actor/parts/actor-effects.hbs"}}
    </div>

  </section>
</form>

