<div class="items-tab-content">

  {{!-- Items Section --}}
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>Items</div>
      <div class='item-controls'>
        <a class='item-control item-create' title='New Item' data-type='item'>
          <i class='fas fa-plus'></i> New Item
        </a>
      </div>
    </li>
    {{#each gear as |item id|}}
      <li class='item flexrow' data-item-id='{{item._id}}'>
        <div class='item-name'>
          <div class='item-image'>
            <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' />
          </div>
          <h4 style="color: {{item.rarityColor}}">{{item.name}}</h4>
        </div>
        <div class='item-controls'>
          {{#if item.deployable}}
            <a class='item-control item-deploy' title='Deploy — place this on the canvas'><i class='fas fa-map-pin'></i></a>
          {{/if}}
          {{#if item.deployed}}
            <a class='item-control item-recover' title='Recover — take it back'><i class='fas fa-hand-back-fist'></i></a>
          {{/if}}
          <a class='item-control item-trade' title='Trade / Give'><i class='fas fa-handshake'></i></a>
          <a class='item-control item-edit' title='Edit'><i class='fas fa-edit'></i></a>
          <a class='item-control item-delete' title='Delete'><i class='fas fa-trash'></i></a>
        </div>
      </li>
    {{/each}}
  </ol>

  {{!-- Consumables Section --}}
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize "ASPECTSOFPOWER.Consumable.sectionTitle"}}</div>
      <span class='item-prop consumable-col-type'>{{localize "ASPECTSOFPOWER.Consumable.type"}}</span>
      <span class='item-prop consumable-col-effect'>Effect</span>
      <span class='item-prop consumable-col-uses'>Uses</span>
      <div class='item-controls'>
        <a class='item-control item-create' title='New Consumable' data-type='consumable'>
          <i class='fas fa-plus'></i> New Consumable
        </a>
      </div>
    </li>
    {{#each consumables as |item id|}}
      <li class='item flexrow' data-item-id='{{item._id}}'>
        <div class='item-name'>
          <div class='item-image'>
            <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' />
          </div>
          <h4 style="color: {{item.rarityColor}}">{{item.name}}</h4>
        </div>
        <span class='item-prop consumable-col-type'>{{item.consumableLabel}}</span>
        <span class='item-prop consumable-col-effect'>{{item.effectSummary}}</span>
        <span class='item-prop consumable-col-uses'>{{item.usesDisplay}}</span>
        <div class='item-controls'>
          <a class='consumable-use' title='{{localize "ASPECTSOFPOWER.Consumable.use"}}'>
            <i class='fas fa-flask'></i>
          </a>
          <a class='item-control item-trade' title='Trade / Give'><i class='fas fa-handshake'></i></a>
          <a class='item-control item-edit' title='Edit'><i class='fas fa-edit'></i></a>
          <a class='item-control item-delete' title='Delete'><i class='fas fa-trash'></i></a>
        </div>
      </li>
    {{/each}}
  </ol>

  {{!-- Recipes. The inventory question ("do I own it") gets shelves here; the
        crafting question ("what can I make right now, and with what") gets
        the Recipe Book window, which is where search, categories and reagent
        counts live. --}}
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>Recipes</div>
      <span class='item-prop'>{{#if recipeCount}}{{recipeCount}} known{{else}}none known{{/if}}</span>
      <div class='item-controls'>
        <a class='item-control open-recipe-book' title='Open the Recipe Book'>
          <i class='fas fa-book-open'></i> Open Book
        </a>
        <a class='item-control item-create' title='New Recipe' data-type='recipe'>
          <i class='fas fa-plus'></i> New Recipe
        </a>
      </div>
    </li>
  </ol>
  {{#each recipeShelves as |shelf|}}
    <details class='aop-section recipe-shelf'>
      <summary>
        <span class='aop-section-title'>{{shelf.label}}</span>
        <span class='aop-section-hint'>{{shelf.recipes.length}}</span>
      </summary>
      <div class='aop-section-body'>
        {{#each shelf.recipes as |r|}}
          <details class='item recipe-entry' data-item-id='{{r._id}}'>
            <summary class='flexrow'>
              <div class='item-image'>
                <img src='{{r.img}}' title='{{r.productName}}' width='20' height='20' />
              </div>
              <h4>{{r.productName}}</h4>
              <span class='item-prop'>{{r.thresholdLabel}}</span>
              {{#if r.isDiscovered}}
                <span class='item-prop' title='Discovered by {{r.system.discoveredBy}}'>discovered</span>
              {{/if}}
              <div class='item-controls'>
                <a class='item-control item-edit' title='Edit'><i class='fas fa-edit'></i></a>
                <a class='item-control item-delete' title='Forget'><i class='fas fa-trash'></i></a>
              </div>
            </summary>
            <div class='recipe-entry-body'>
              {{#if r.billLines.length}}
                <p><strong>Needs:</strong> {{#each r.billLines as |line|}}{{line}}{{#unless @last}} &middot; {{/unless}}{{/each}}</p>
              {{else}}
                <p class='hint'>No ingredients listed.</p>
              {{/if}}
              {{#if r.system.minMana}}<p><strong>Mana:</strong> at least {{r.system.minMana}}</p>{{/if}}
              {{#if r.system.output.typeKey}}<p><strong>Makes:</strong> {{r.system.output.typeKey}}</p>{{/if}}
              {{#if r.system.requiresSkillTags.length}}
                <p class='hint'>Requires a craft skill tagged {{join r.system.requiresSkillTags ', '}}.</p>
              {{/if}}
            </div>
          </details>
        {{/each}}
      </div>
    </details>
  {{/each}}

  {{!-- Features Section --}}
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>Features</div>
      <div class='item-controls'>
        <a class='item-control item-create' title='New Feature' data-type='feature'>
          <i class='fas fa-plus'></i> New Feature
        </a>
      </div>
    </li>
    {{#each features as |item id|}}
      <li class='item flexrow' data-item-id='{{item._id}}'>
        <div class='item-name'>
          <div class='item-image'>
            <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' />
          </div>
          <h4>{{item.name}}</h4>
        </div>
        <div class='item-controls'>
          <a class='item-control item-edit' title='Edit'><i class='fas fa-edit'></i></a>
          <a class='item-control item-delete' title='Delete'><i class='fas fa-trash'></i></a>
        </div>
      </li>
    {{/each}}
  </ol>

</div>